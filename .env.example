# Local development template. Copy to a private .env; fill owner settings before startup.
# For production, use README.md's /data overrides in a separate private environment file.
# Keep real secrets out of source control. Preserve existing secrets during migration.

# Owner-only app login: basic Google identity, independent of optional Gmail OAuth.
# Set the exact owner email and a web client ID whose JavaScript origin matches APP_BASE_URL.
# APP_GOOGLE_CLIENT_ID does not fall back to GOOGLE_CLIENT_ID; no client secret is needed here.
APP_LOGIN_REQUIRED=true
APP_OWNER_EMAIL=owner@example.com
APP_GOOGLE_CLIENT_ID=
APP_BASE_URL=http://127.0.0.1:8000
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters; keep stable across restarts. Changing it invalidates sessions.
APP_SESSION_SECRET=
APP_ENV=development

# Fail-closed migration locks. Do not connect live Gmail or send real email during migration.
# Campaign dry-run toggles cannot override these server locks.
GMAIL_CONNECTION_ENABLED=false
EMAIL_SENDING_ENABLED=false
DRY_RUN_DEFAULT=true

# Operator-supplied Fernet key for encrypted Gmail access/refresh tokens; never per-session.
# Required in production even when Gmail is disabled; required for token encryption/decryption.
# Generate ONLY for a new installation; preserve the existing key with migrated credentials:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable across restarts/redeploys and back up securely; a replacement cannot decrypt old data.
ENCRYPTION_KEY=

# Local SQLite/storage defaults. Production requires an existing durable DATA_DIR writable
# by UID/GID 10001:10001, with absolute database/checkpoint/upload paths inside it.
# Production: DATABASE_URL=sqlite:////data/outreach.db, UPLOAD_DIR=/data/uploads.
# CHECKPOINT_DATABASE_URL=sqlite:////data/checkpoints.db in production, but graph
# checkpoint persistence is NOT wired up; this does not enable resumable workflows.
DATA_DIR=/data
DATABASE_URL=sqlite:///./outreach.db
CHECKPOINT_DATABASE_URL=sqlite:///./checkpoints.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Optional Gmail OAuth: unused for owner login; leave blank during migration.
# Current scopes: https://www.googleapis.com/auth/gmail.send,
# https://www.googleapis.com/auth/gmail.modify (mailbox read/modify), openid,
# https://www.googleapis.com/auth/userinfo.email.
# A later authorized setup needs Gmail API enabled and this exact registered callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional LLM providers: leave keys blank for provider-free checks.
# Dry-run delivery can still call these providers for AI analysis/drafting when configured.
# "fireworks" uses OpenAI fallback only if OPENAI_API_KEY is set; "openai" uses OpenAI directly.
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/kimi-k2p5-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Application limits and logging
LOG_LEVEL=INFO
MAX_SEND_RATE_PER_MINUTE=30
MAX_CONCURRENT_SENDS=3
MAX_DRAFT_RETRIES=3
